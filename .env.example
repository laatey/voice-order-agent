# ─── Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX           # The Twilio number that receives calls & sends SMS

# ─── Hubtel (SMS Confirmation) ────────────────────────────
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=ChopTime

# ─── Deepgram ─────────────────────────────────────────────
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# ─── Anthropic ────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ─── Server ───────────────────────────────────────────────
PORT=5000
# Your public HTTPS URL (needed for the Twilio webhook and WS stream URL).
PUBLIC_URL=https://your-app.replit.app

# ─── App ──────────────────────────────────────────────────
BUSINESS_NAME=Chop Time Restaurant
BUSINESS_PHONE=0244000000
